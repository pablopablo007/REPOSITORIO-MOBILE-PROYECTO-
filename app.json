{
  "expo": {
    "name": "PrototipoMobileSudamericano",
    "slug": "PrototipoMobileSudamericano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prototipomobilesudamericano",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EduSudamericano necesita la cámara para escanear documentos académicos.",
        "NSPhotoLibraryUsageDescription": "EduSudamericano necesita acceso a fotos para importar documentos.",
        "NSPhotoLibraryAddUsageDescription": "Para guardar documentos escaneados en tu galería."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.anonymous.PrototipoMobileSudamericano"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para subir evidencias.",
          "cameraPermission": "La app necesita acceso a la cámara para escanear documentos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EduSudamericano necesita la cámara para escanear documentos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Necesitamos acceso a tu galería para importar documentos.",
          "savePhotosPermission": "Para guardar documentos escaneados."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
