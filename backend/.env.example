# EduSudamericano Backend - .env.example
# Copia este archivo a .env y rellena los valores

PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/sudabase?schema=public"

JWT_SECRET="cambiar-por-clave-segura"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="cambiar-por-clave-segura-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=20
CLIENT_URL="http://localhost:8081"
