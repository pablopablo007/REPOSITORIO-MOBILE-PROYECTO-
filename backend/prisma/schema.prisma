generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════

enum Role {
  DOCENTE
  ADMIN
  REVISOR
}

enum DocumentType {
  ACADEMICO
  TITULO
  INFORME
  ACTA
  GENERADO_IA
  ESCANEADO
  OTRO
}

enum EvidenceStatus {
  PENDIENTE
  VALIDADO
  OBSERVADO
}

enum NotificationType {
  SUCCESS
  WARNING
  INFO
}

// ══════════════════════════════════════════════════
// USUARIOS
// ══════════════════════════════════════════════════

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatar       String?
  active       Boolean  @default(true)
  phone        String?
  department   String?
  period       String?
  initials     String?
  degree       String?
  role         Role     @default(DOCENTE)
  pushToken    String?  @map("push_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  evidences     Evidence[]
  tasks         Task[]
  notifications Notification[]

  @@map("users")
}

// ══════════════════════════════════════════════════
// EVIDENCIAS (documentos subidos)
// ══════════════════════════════════════════════════

model Evidence {
  id           String         @id @default(uuid())
  docenteId    String         @map("docente_id")
  documentType DocumentType   @map("document_type")
  periodo      String
  fileName     String         @map("file_name")
  fileUrl      String?        @map("file_url")
  fileSize     String?        @map("file_size")
  status       EvidenceStatus @default(PENDIENTE)
  comment      String?
  reviewerName String?        @map("reviewer_name")
  description  String?
  iaGenerated  Boolean        @default(false) @map("ia_generated")
  scanned      Boolean        @default(false)
  indicatorId  String?        @map("indicator_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  docente       User  @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  completedTask Task? @relation("CompletedEvidence")

  @@map("evidences")
}

// ══════════════════════════════════════════════════
// TAREAS (actividades asignadas)
// ══════════════════════════════════════════════════

model Task {
  id                  String       @id @default(uuid())
  docenteId           String       @map("docente_id")
  title               String
  description         String
  deadline            DateTime
  documentType        DocumentType @map("document_type")
  completed           Boolean      @default(false)
  completedEvidenceId String?      @unique @map("completed_evidence_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  docente           User      @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  completedEvidence Evidence? @relation("CompletedEvidence", fields: [completedEvidenceId], references: [id])

  @@map("tasks")
}

// ══════════════════════════════════════════════════
// NOTIFICACIONES
// ══════════════════════════════════════════════════

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type       NotificationType
  isRead     Boolean          @default(false) @map("is_read")
  evidenceId String?          @map("evidence_id")
  taskId     String?          @map("task_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ══════════════════════════════════════════════════
// INDICADORES CACES (catálogo académico)
// ══════════════════════════════════════════════════

model CacesCategory {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  subcategories CacesSubcategory[]

  @@map("caces_categories")
}

model CacesSubcategory {
  id         String          @id @default(uuid())
  code       String          @unique
  name       String
  categoryId String          @map("category_id")
  indicators CacesIndicator[]

  category CacesCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("caces_subcategories")
}

model CacesIndicator {
  id            String @id @default(uuid())
  code          String @unique
  name          String
  subcategoryId String @map("subcategory_id")

  subcategory CacesSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@map("caces_indicators")
}
